# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SENTINEL_FORM_INTAKE_URL: URL completa del form-intake de Sentinel para el cliente SCALA
# (https://<backend-de-sentinel>/webhook/form-intake/<client_id>). La usa api/lead.ts para
# registrar cada lead del formulario propio en el CRM y dispararle el WhatsApp de apertura.
# Sólo del lado del servidor: NO lleva prefijo VITE_, no debe llegar al navegador.
# Además funciona como interruptor: si falta al compilar, el sitio sigue mostrando Jotform
# en vez del formulario propio (ver src/components/lead-form/formularioPropio.ts).
SENTINEL_FORM_INTAKE_URL=

# META_CAPI_ACCESS_TOKEN: token de Conversions API del pixel de campañas ("SCALA LEADS FORM VSL",
# 4697348820512055). Se genera en el Administrador de eventos → Configuración → Conversions API.
# Lo usa api/lead.ts para mandar SubmitApplication por servidor cuando el lead factura USD 3.000 o más.
# Sólo del lado del servidor. Si falta, el formulario funciona igual y no se manda el evento.
META_CAPI_ACCESS_TOKEN=

# META_CAPI_TEST_EVENT_CODE: SÓLO PARA PROBAR. Con esto los eventos aparecen en "Probar eventos"
# y no cuentan para las campañas. Dejarlo vacío en producción.
META_CAPI_TEST_EVENT_CODE=
